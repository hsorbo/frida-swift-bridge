{
  "name": "frida-swift-bridge2",
  "version": "1.0.0",
  "description": "A TypeScript library for Frida's GumJS runtime.",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./abi": {
      "types": "./dist/abi.d.ts",
      "import": "./dist/abi.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "pretest": "sh tests/fixtures/build.sh",
    "test": "injest",
    "pretest:v8": "sh tests/fixtures/build.sh",
    "test:v8": "injest --target local-v8",
    "pretest:macos-arm64e": "ARCH=arm64e sh tests/fixtures/build.sh",
    "test:macos-arm64e": "injest --target macos-arm64e",
    "pretest:macos-arm64e-v8": "ARCH=arm64e sh tests/fixtures/build.sh",
    "test:macos-arm64e-v8": "injest --target macos-arm64e-v8",
    "pretest:ios": "PLATFORM=ios EMBED_FIXTURES=1 sh tests/fixtures/build.sh",
    "test:ios": "injest --target ios",
    "prebench": "sh tests/fixtures/build.sh",
    "bench": "injest --bench --baseline bench/baseline.json",
    "prebench:update": "sh tests/fixtures/build.sh",
    "bench:update": "injest --bench --baseline bench/baseline.json --update",
    "prebench:cold": "ARCH=arm64e sh tests/fixtures/build.sh",
    "bench:cold": "injest --bench --baseline bench/baseline.json --target macos-arm64e cold",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "frida": "^17.24.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@frida/injest": "^0.2.0",
    "@types/frida-gum": "^19.12.0",
    "@types/node": "^26.1.0"
  },
  "allowScripts": {
    "frida@17.24.0": true
  }
}
